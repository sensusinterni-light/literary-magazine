---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allArticles = await getCollection('articles');

const ISSUE_IMAGES: Record<number, string> = {
  1: 'https://images.pexels.com/photos/11516769/pexels-photo-11516769.jpeg?auto=compress&cs=tinysrgb&h=650&w=940',
  2: 'https://images.pexels.com/photos/36070133/pexels-photo-36070133.jpeg?auto=compress&cs=tinysrgb&h=650&w=940',
  3: 'https://images.pexels.com/photos/14749518/pexels-photo-14749518.jpeg?auto=compress&cs=tinysrgb&h=650&w=940',
};

const HERO_IMAGE = 'https://images.pexels.com/photos/12708286/pexels-photo-12708286.jpeg?auto=compress&cs=tinysrgb&h=650&w=940';

const issues = allArticles.reduce<Record<number, {
  title: string;
  date: string;
  articles: typeof allArticles;
}>>((acc, a) => {
  const n = a.data.issue;
  if (!acc[n]) acc[n] = { title: a.data.issueTitle, date: a.data.issueDate, articles: [] };
  acc[n].articles.push(a);
  return acc;
}, {});

const sortedNumbers = Object.keys(issues).map(Number).sort((a, b) => b - a);
const [featuredNum, ...archiveNums] = sortedNumbers;
const featured = issues[featuredNum];
const featuredArticles = [...featured.articles].sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

function toRoman(n: number): string {
  const vals = [1000,900,500,400,100,90,50,40,10,9,5,4,1];
  const syms = ['M','CM','D','CD','C','XC','L','XL','X','IX','V','IV','I'];
  let r = '';
  for (let i = 0; i < vals.length; i++) while (n >= vals[i]) { r += syms[i]; n -= vals[i]; }
  return r;
}

function typeLabel(t: string) { return t === 'poetry' ? 'поэзия' : 'проза'; }
---

<Layout>
  <!-- ═══════════════════════════════════════ MASTHEAD ═══════════════════════════════════════ -->
  <header class="relative overflow-hidden" style="min-height: 560px;">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style={`background-image: url('${HERO_IMAGE}')`}
    ></div>
    <div class="absolute inset-0 bg-gradient-to-b from-dark-900/90 via-dark-900/80 to-dark-900/95"></div>

    <div class="relative z-10 flex flex-col" style="min-height: 560px;">
      <!-- Nav -->
      <nav class="flex items-center justify-between px-8 md:px-16 pt-8 pb-6 border-b border-white/10">
        <div class="flex items-center gap-2">
          <div class="w-px h-5 bg-sepia-light opacity-60"></div>
          <span class="font-sans text-[10px] tracking-[0.25em] uppercase text-white/50 font-light">
            Литературный журнал
          </span>
        </div>
        <nav class="hidden sm:flex items-center gap-8">
          <a href="#archive" class="font-sans text-[11px] tracking-[0.18em] uppercase text-white/50 hover:text-white/90 transition-colors font-light">
            Выпуски
          </a>
          <a href="#about" class="font-sans text-[11px] tracking-[0.18em] uppercase text-white/50 hover:text-white/90 transition-colors font-light">
            О журнале
          </a>
        </nav>
      </nav>

      <!-- Title -->
      <div class="flex flex-1 flex-col items-center justify-center text-center px-8 py-16">
        <div class="w-12 h-px bg-sepia-light mb-8 opacity-70"></div>
        <h1
          class="text-white font-serif font-light leading-none tracking-[0.08em] mb-5"
          style="font-size: clamp(4rem, 12vw, 8rem);"
        >
          Полночь
        </h1>
        <p class="font-sans text-[11px] tracking-[0.3em] uppercase text-white/40 font-light mb-2">
          Основан в 2024 году
        </p>
        <div class="w-12 h-px bg-sepia-light mt-8 opacity-70"></div>
      </div>

      <!-- Issue teaser -->
      <div class="flex items-center justify-center px-8 pb-10 gap-6">
        <div class="h-px flex-1 max-w-24 bg-white/10"></div>
        <span class="font-sans text-[10px] tracking-[0.2em] uppercase text-white/35 font-light">
          Свежий выпуск — {featured.date}
        </span>
        <div class="h-px flex-1 max-w-24 bg-white/10"></div>
      </div>
    </div>
  </header>

  <!-- ═══════════════════════════════════════ FEATURED ISSUE ═══════════════════════════════════════ -->
  <section class="bg-cream-100">
    <div class="max-w-6xl mx-auto px-6 md:px-12 lg:px-16 py-20">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-0 border border-ink-100 overflow-hidden">
        <!-- Image -->
        <div class="lg:col-span-3 relative overflow-hidden" style="min-height: 420px;">
          <img
            src={ISSUE_IMAGES[featuredNum]}
            alt={`Выпуск ${toRoman(featuredNum)} — ${featured.title}`}
            class="absolute inset-0 w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-transparent via-transparent to-dark-900/20 lg:to-dark-900/40"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 lg:p-8">
            <div class="inline-block bg-sepia/90 px-3 py-1 mb-3">
              <span class="font-sans text-[10px] tracking-[0.2em] uppercase text-white font-light">
                Свежий выпуск
              </span>
            </div>
          </div>
        </div>

        <!-- Content -->
        <div class="lg:col-span-2 flex flex-col justify-center bg-cream-50 p-8 md:p-10 lg:p-12">
          <span class="font-sans text-[10px] tracking-[0.22em] uppercase text-ink-400 font-light mb-4">
            Выпуск {toRoman(featuredNum)}
          </span>
          <h2 class="font-serif font-light text-ink leading-none mb-2" style="font-size: 2.8rem;">
            {featured.title}
          </h2>
          <p class="font-sans text-[11px] tracking-[0.12em] text-ink-400 font-light mb-8">{featured.date}</p>

          <div class="w-8 h-px bg-ink-100 mb-8"></div>

          <ul class="space-y-5">
            {featuredArticles.map(article => (
              <li>
                <a
                  href={`/articles/${article.id.replace(/\.md$/, '')}`}
                  class="group flex flex-col gap-1"
                >
                  <span class="font-serif text-xl font-light text-ink group-hover:text-sepia transition-colors leading-tight">
                    {article.data.title}
                  </span>
                  <span class="flex items-center gap-2">
                    <span class="font-serif text-sm italic text-ink-400">{article.data.author}</span>
                    <span class="w-px h-3 bg-ink-100"></span>
                    <span class="font-sans text-[9px] tracking-[0.14em] uppercase text-ink-200">{typeLabel(article.data.type)}</span>
                  </span>
                  {article.data.excerpt && (
                    <span class="font-serif text-sm italic text-ink-400 leading-relaxed mt-1 line-clamp-2">
                      {article.data.excerpt}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ ARCHIVE ═══════════════════════════════════════ -->
  {archiveNums.length > 0 && (
    <section id="archive" class="bg-cream-200 py-20">
      <div class="max-w-6xl mx-auto px-6 md:px-12 lg:px-16">
        <div class="flex items-center gap-6 mb-14">
          <span class="font-sans text-[10px] tracking-[0.28em] uppercase text-ink-400 font-light whitespace-nowrap">
            Архив выпусков
          </span>
          <div class="flex-1 h-px bg-ink-100"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {archiveNums.map(num => {
            const issue = issues[num];
            const arts = [...issue.articles].sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
            return (
              <article class="group bg-cream-50 border border-ink-100 overflow-hidden flex flex-col hover:border-ink-200 transition-colors">
                <!-- Card image -->
                <div class="relative overflow-hidden" style="height: 260px;">
                  <img
                    src={ISSUE_IMAGES[num]}
                    alt={`Выпуск ${toRoman(num)} — ${issue.title}`}
                    class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-700"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-dark-900/60 via-transparent to-transparent"></div>
                  <div class="absolute bottom-4 left-5 right-5 flex items-end justify-between">
                    <div>
                      <span class="font-sans text-[9px] tracking-[0.22em] uppercase text-white/60 font-light block mb-1">
                        Выпуск {toRoman(num)}
                      </span>
                      <h3 class="font-serif font-light text-white text-2xl leading-tight">
                        {issue.title}
                      </h3>
                    </div>
                    <span class="font-sans text-[9px] text-white/40 font-light tracking-wide">{issue.date}</span>
                  </div>
                </div>

                <!-- Article list -->
                <div class="flex-1 p-6 md:p-7">
                  <ul class="space-y-4">
                    {arts.map(article => (
                      <li class="border-b border-ink-100 pb-4 last:border-0 last:pb-0">
                        <a
                          href={`/articles/${article.id.replace(/\.md$/, '')}`}
                          class="group/link flex items-baseline justify-between gap-3"
                        >
                          <span class="font-serif text-lg font-light text-ink group-hover/link:text-sepia transition-colors">
                            {article.data.title}
                          </span>
                          <span class="flex items-center gap-2 shrink-0">
                            <span class="font-serif text-sm italic text-ink-400">{article.data.author}</span>
                            <span class="font-sans text-[8px] tracking-[0.14em] uppercase text-ink-200">{typeLabel(article.data.type)}</span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════ ABOUT ═══════════════════════════════════════ -->
  <section id="about" class="bg-dark-900 py-24">
    <div class="max-w-2xl mx-auto px-8 text-center">
      <div class="w-8 h-px bg-sepia-light/50 mx-auto mb-10"></div>
      <h2 class="font-serif font-light text-white/90 text-4xl mb-6 leading-tight">О журнале</h2>
      <p class="font-serif font-light text-white/50 text-lg leading-relaxed italic">
        «Полночь» — литературный журнал, посвящённый поэзии и прозе. Мы публикуем тексты, которые не торопятся. Выпуски выходят по временам года.
      </p>
      <div class="w-8 h-px bg-sepia-light/50 mx-auto mt-10"></div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ FOOTER ═══════════════════════════════════════ -->
  <footer class="bg-dark-DEFAULT border-t border-white/5 py-8">
    <div class="max-w-6xl mx-auto px-8 flex items-center justify-between">
      <span class="font-serif font-light text-white/25 text-lg tracking-wide">Полночь</span>
      <span class="font-sans text-[10px] tracking-[0.15em] uppercase text-white/20 font-light">
        Литературный журнал · 2024
      </span>
    </div>
  </footer>
</Layout>
