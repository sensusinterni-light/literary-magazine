---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(entry => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const isPoetry = entry.data.type === 'poetry';

function toRoman(n: number): string {
  const vals = [1000,900,500,400,100,90,50,40,10,9,5,4,1];
  const syms = ['M','CM','D','CD','C','XC','L','XL','X','IX','V','IV','I'];
  let r = '';
  for (let i = 0; i < vals.length; i++) while (n >= vals[i]) { r += syms[i]; n -= vals[i]; }
  return r;
}
---

<Layout title={entry.data.title}>
  <!-- ── Nav ── -->
  <nav class="sticky top-0 z-20 bg-cream-100/95 backdrop-blur-sm border-b border-ink-100">
    <div class="max-w-4xl mx-auto px-6 md:px-10 py-4 flex items-center justify-between">
      <a
        href="/"
        class="flex items-center gap-2 group text-ink-400 hover:text-ink transition-colors"
      >
        <span class="text-sm font-sans font-light tracking-wide group-hover:-translate-x-0.5 transition-transform">←</span>
        <span class="font-serif text-lg font-light">Полночь</span>
      </a>
      <span class="font-sans text-[10px] tracking-[0.18em] uppercase text-ink-200 font-light hidden sm:block">
        Выпуск {toRoman(entry.data.issue)} · {entry.data.issueTitle}
      </span>
    </div>
  </nav>

  <!-- ── Article ── -->
  <main class="bg-cream-100 min-h-screen">
    <article class="max-w-2xl mx-auto px-6 md:px-10 py-16 md:py-24">

      <!-- Header -->
      <header class="mb-14">
        <span class="font-sans text-[10px] tracking-[0.28em] uppercase text-sepia font-light block mb-6">
          {isPoetry ? 'поэзия' : 'проза'}
        </span>

        <h1 class="font-serif font-light text-ink leading-[1.05] mb-5"
            style="font-size: clamp(2.4rem, 6vw, 3.8rem);">
          {entry.data.title}
        </h1>

        <div class="flex items-center gap-3 mb-8">
          <span class="font-serif italic font-light text-ink-400 text-lg">
            {entry.data.author}
          </span>
          <span class="w-px h-4 bg-ink-100"></span>
          <span class="font-sans text-[10px] tracking-[0.15em] uppercase text-ink-200 font-light">
            {entry.data.issueDate}
          </span>
        </div>

        <div class="w-full h-px bg-ink-100"></div>
      </header>

      <!-- Body -->
      {isPoetry ? (
        <div class="poem">
          <Content />
        </div>
      ) : (
        <div class="prose-journal">
          <Content />
        </div>
      )}

    </article>
  </main>

  <!-- ── Footer ── -->
  <footer class="bg-cream-200 border-t border-ink-100 py-10">
    <div class="max-w-2xl mx-auto px-6 md:px-10 flex items-center justify-between gap-4">
      <a
        href="/"
        class="font-sans text-[11px] tracking-[0.12em] uppercase text-ink-400 hover:text-ink transition-colors font-light"
      >
        ← Вернуться к журналу
      </a>
      <span class="font-sans text-[10px] tracking-[0.12em] text-ink-200 font-light">
        {entry.data.issueDate}
      </span>
    </div>
  </footer>
</Layout>

<style>
  /* ── Poetry ── */
  .poem :global(p) {
    font-family: 'Cormorant Garamond', Georgia, Palatino, serif;
    font-size: 1.25rem;
    font-style: italic;
    font-weight: 300;
    line-height: 2.1;
    color: #1a1816;
    text-align: left;
    margin-bottom: 2.5rem;
    hyphens: none;
  }

  .poem :global(p:last-child) {
    margin-bottom: 0;
  }

  .poem :global(br) {
    display: block;
    content: '';
  }

  /* ── Prose ── */
  .prose-journal :global(p) {
    font-family: 'Cormorant Garamond', Georgia, Palatino, serif;
    font-size: 1.2rem;
    font-weight: 300;
    line-height: 1.95;
    color: #1a1816;
    text-align: justify;
    hyphens: auto;
    margin-bottom: 1.75em;
  }

  .prose-journal :global(p:last-child) {
    margin-bottom: 0;
  }

  .prose-journal :global(p:first-of-type::first-letter) {
    font-size: 4.2em;
    font-weight: 300;
    float: left;
    line-height: 0.78;
    margin-right: 0.08em;
    margin-top: 0.06em;
    color: #8b6b4a;
    font-style: normal;
  }
</style>
