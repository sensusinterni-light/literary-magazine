---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'Полночь', description = 'Литературный журнал' } = Astro.props;
const pageTitle = title === 'Полночь' ? 'Полночь — Литературный журнал' : `${title} — Полночь`;
---
<!doctype html>
<html lang="ru" class="bg-cream-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Inter:wght@300;400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-serif text-ink antialiased min-h-screen">
    <slot />
  </body>
</html>
